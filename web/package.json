{
  "name": "tvbt-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "contracts:generate": "openapi-typescript ../contracts/openapi.yaml -o src/types/generated/api.d.ts",
    "contracts:bundle": "node scripts/bundle-openapi.mjs",
    "contracts:validate": "node scripts/validate-contracts.mjs",
    "e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "lightweight-charts": "5.2.0",
    "vue": "3.5.40",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.2",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9",
    "yaml": "2.9.0"
  }
}
