{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/chanlun/signal_event.schema.json",
  "title": "Chanlun structural signal event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "symbol",
    "signal_type",
    "analysis_level",
    "component_kind",
    "direction",
    "status",
    "endpoint_time",
    "confirmed_at",
    "signal_price_ticks",
    "evidence_ids",
    "rule_version"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "symbol": {"type": "string", "minLength": 1},
    "signal_type": {
      "enum": [
        "B1", "S1", "B2", "S2", "B3", "S3",
        "trend_divergence", "consolidation_divergence",
        "centre_confirmed", "centre_extended", "centre_promotion_candidate",
        "breakout_candidate"
      ]
    },
    "analysis_level": {"type": "string", "minLength": 1},
    "execution_level": {"type": ["string", "null"]},
    "component_kind": {
      "enum": ["segment", "lower_level_movement", "stroke_experimental"]
    },
    "direction": {"enum": ["up", "down", "neutral"]},
    "status": {"enum": ["candidate", "confirmed", "invalidated"]},
    "endpoint_time": {"type": "string", "format": "date-time"},
    "confirmed_at": {"type": ["string", "null"], "format": "date-time"},
    "invalidated_at": {"type": ["string", "null"], "format": "date-time"},
    "signal_price_ticks": {"type": "integer"},
    "executable_price_ticks": {"type": ["integer", "null"]},
    "min_tick": {"type": ["string", "null"], "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "centre_id": {"type": ["string", "null"]},
    "ZD_ticks": {"type": ["integer", "null"]},
    "ZG_ticks": {"type": ["integer", "null"]},
    "DD_ticks": {"type": ["integer", "null"]},
    "GG_ticks": {"type": ["integer", "null"]},
    "strength": {
      "enum": ["strong", "normal", "weak", "not_applicable"]
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "parent_event_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "auxiliary_evidence_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "rule_version": {"type": "string", "minLength": 1},
    "data_version": {"type": ["string", "null"]},
    "config_hash": {"type": ["string", "null"]},
    "supersedes_event_id": {"type": ["string", "null"]},
    "invalidation_reason": {"type": ["string", "null"]},
    "metadata": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "confirmed"}}},
      "then": {
        "properties": {
          "confirmed_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "invalidated"}}},
      "then": {"required": ["invalidated_at", "invalidation_reason"]}
    },
    {
      "if": {"properties": {"component_kind": {"const": "stroke_experimental"}}},
      "then": {
        "properties": {
          "metadata": {
            "type": "object",
            "required": ["experimental"],
            "properties": {"experimental": {"const": true}}
          }
        }
      }
    },
    {
      "if": {"properties": {"signal_type": {"enum": ["B3", "S3"]}}},
      "then": {"required": ["centre_id", "ZD_ticks", "ZG_ticks"]}
    }
  ]
}
