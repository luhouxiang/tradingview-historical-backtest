{
  "spec_version": "1.0.0",
  "theory_profile": "chanlun_108_strict",
  "price_unit": "integer_ticks",
  "floating_epsilon_allowed": false,
  "pipeline": [
    "raw_kline",
    "sequential_directional_inclusion",
    "processed_kline",
    "fractal_detection",
    "same_type_fractal_reduction",
    "bi_assembly",
    "bi_state_update"
  ],
  "state_machine": {
    "encoding": {
      "UP_EXTENDING": [1, 1],
      "UP_TOP_FRACTAL_BUILDING": [1, 0],
      "DOWN_EXTENDING": [-1, 1],
      "DOWN_BOTTOM_FRACTAL_BUILDING": [-1, 0]
    },
    "allowed_transitions": {
      "UP_EXTENDING": ["UP_TOP_FRACTAL_BUILDING"],
      "UP_TOP_FRACTAL_BUILDING": ["UP_EXTENDING", "DOWN_EXTENDING"],
      "DOWN_EXTENDING": ["DOWN_BOTTOM_FRACTAL_BUILDING"],
      "DOWN_BOTTOM_FRACTAL_BUILDING": ["DOWN_EXTENDING", "UP_EXTENDING"]
    },
    "source_rule": "L91_STATE"
  },
  "cases": [
    {
      "id": "L62_F1_TOP_FRACTAL",
