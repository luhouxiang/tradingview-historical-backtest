      "layer": "bar_preprocess",
      "name_zh": "向上包含合并",
      "evidence_level": "FORMAL",
      "source_lessons": [62, 65],
      "inputs": ["previous_processed_bar", "incoming_bar", "direction=up"],
      "predicate": "interval_contains(a,b) or interval_contains(b,a)",
      "output": {"high": "max(a.high,b.high)", "low": "max(a.low,b.low)"},
      "confirmation": "incoming_bar_closed",
      "notes": "sequential; preserve raw member and extreme provenance"
    },
    {
      "id": "BAR-INCLUDE-DOWN",
