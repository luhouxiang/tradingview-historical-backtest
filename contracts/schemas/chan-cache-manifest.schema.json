{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/chan-cache-manifest.schema.json",
  "title": "ChanCacheManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "cache_key", "dataset_id", "data_revision", "algorithm",
    "parameters", "calculation_mode", "engine_version", "coverage", "counts",
    "files", "checkpoint", "created_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "cache_key": {"$ref": "#/$defs/sha256"},
    "dataset_id": {"type": "string", "minLength": 1},
    "data_revision": {"$ref": "#/$defs/sha256"},
    "algorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "algorithm_id", "algorithm_version", "source_hash"],
      "properties": {
        "kind": {"const": "chan"},
        "algorithm_id": {"type": "string", "minLength": 1},
        "algorithm_version": {"type": "string", "minLength": 1},
        "source_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "parameters": {"type": "object"},
    "calculation_mode": {"const": "causal_events"},
    "engine_version": {"type": "string", "minLength": 1},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bar_count", "first_bar_index", "last_bar_index"],
      "properties": {
        "bar_count": {"type": "integer", "minimum": 0},
        "first_bar_index": {"type": "integer", "minimum": 0},
        "last_bar_index": {"type": "integer", "minimum": 0}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["merged_bars", "fractals", "bi", "segments", "zhongshu", "segment_zhongshu", "divergences", "trade_points", "events"],
      "properties": {
        "merged_bars": {"type": "integer", "minimum": 0},
        "fractals": {"type": "integer", "minimum": 0},
        "bi": {"type": "integer", "minimum": 0},
        "segments": {"type": "integer", "minimum": 0},
        "zhongshu": {"type": "integer", "minimum": 0},
        "segment_zhongshu": {"type": "integer", "minimum": 0},
        "divergences": {"type": "integer", "minimum": 0},
        "trade_points": {"type": "integer", "minimum": 0},
        "events": {"type": "integer", "minimum": 0}
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fractals", "bi", "segments", "zhongshu", "segment_zhongshu", "divergences", "trade_points", "events"],
      "properties": {
        "fractals": {"$ref": "#/$defs/file"},
        "bi": {"$ref": "#/$defs/file"},
        "segments": {"$ref": "#/$defs/file"},
        "zhongshu": {"$ref": "#/$defs/file"},
        "segment_zhongshu": {"$ref": "#/$defs/file"},
        "divergences": {"$ref": "#/$defs/file"},
        "trade_points": {"$ref": "#/$defs/file"},
        "events": {"$ref": "#/$defs/file"}
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "algorithm_version", "interval_bars", "count", "last_bar_index"],
      "properties": {
        "format": {"const": "tvbt-chan-checkpoint-v1"},
        "algorithm_version": {"type": "string", "minLength": 1},
        "interval_bars": {"type": "integer", "minimum": 1},
        "count": {"type": "integer", "minimum": 0},
        "last_bar_index": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "row_count", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^[^\\\\/]+\\.parquet$"},
        "row_count": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
