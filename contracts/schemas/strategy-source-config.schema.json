{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/strategy-source-config.schema.json",
  "title": "StrategySourceDynamicConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "revision", "strategy_sources", "updated_at"],
  "properties": {
    "request_id": {"type": "string"},
    "schema_version": {"const": 1},
    "profile_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "strategy_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dataset_id", "data_revision", "source_id", "visible", "category_visibility"],
        "properties": {
          "dataset_id": {"type": "string", "minLength": 1},
          "data_revision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "source_id": {"type": "string", "minLength": 1},
          "visible": {"type": "boolean"},
          "category_visibility": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fractals", "bi", "segments", "bi_centers", "segment_centers", "bi_boundary_confirmations", "segment_boundary_confirmations", "movement_states", "center_monitors", "divergences", "first_trade_points", "second_trade_points", "third_trade_points"],
            "properties": {
              "processed_bars": {"type": "boolean"},
              "fractals": {"type": "boolean"},
              "bi": {"type": "boolean"},
                "bi_states": {"type": "boolean"},
              "segments": {"type": "boolean"},
              "bi_centers": {"type": "boolean"},
              "segment_centers": {"type": "boolean"},
              "center_objects": {"type": "boolean"},
              "bi_boundary_confirmations": {"type": "boolean"},
              "segment_boundary_confirmations": {"type": "boolean"},
              "movement_states": {"type": "boolean"},
              "center_monitors": {"type": "boolean"},
              "divergences": {"type": "boolean"},
              "first_trade_points": {"type": "boolean"},
              "second_trade_points": {"type": "boolean"},
              "third_trade_points": {"type": "boolean"},
              "class_first_trade_points": {"type": "boolean"},
              "class_second_trade_points": {"type": "boolean"},
              "class_third_trade_points": {"type": "boolean"}
            }
          }
        }
      }
    },
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
