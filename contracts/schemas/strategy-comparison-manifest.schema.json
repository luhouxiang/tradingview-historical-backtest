{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/strategy-comparison-manifest.schema.json",
  "title": "StrategyComparisonManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "comparison_id", "trace_id", "dataset", "range",
    "comparison_signature", "aggregator_version", "execution", "capital", "random_seed", "minimum_trade_count", "strategies",
    "strategy_count", "completed_count", "failed_count", "created_at"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "comparison_id": {"type": "string", "minLength": 1},
    "comparison_signature": {"$ref": "#/$defs/sha256"},
    "aggregator_version": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string", "minLength": 1},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "data_revision"],
      "properties": {
        "dataset_id": {"type": "string", "minLength": 1},
        "data_revision": {"$ref": "#/$defs/sha256"}
      }
    },
    "range": {"$ref": "#/$defs/range"},
    "execution": {"type": "object", "additionalProperties": true},
    "capital": {"type": "object", "additionalProperties": true},
    "risk_overlay": {"type": "object", "additionalProperties": true},
    "random_seed": {"type": "integer"},
    "minimum_trade_count": {"type": "integer", "minimum": 1},
    "strategies": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["strategy", "parameters"],
        "properties": {
          "strategy": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "algorithm_id", "algorithm_version", "source_hash"],
            "properties": {
              "kind": {"const": "strategy"}, "algorithm_id": {"type": "string"},
              "algorithm_version": {"type": "string"}, "source_hash": {"$ref": "#/$defs/sha256"}
            }
          },
          "parameters": {"type": "object"}
        }
      }
    },
    "shared_dependency": {"type": "object"},
    "journal_status": {"enum": ["running", "cancelling", "interrupted", "cancelled"]},
    "completed_algorithm_ids": {"type": "array", "items": {"type": "string"}},
    "remaining_algorithm_ids": {"type": "array", "items": {"type": "string"}},
    "strategy_count": {"type": "integer", "minimum": 1},
    "completed_count": {"type": "integer", "minimum": 0},
    "failed_count": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warmup_from_bar_index", "from_bar_index", "to_bar_index"],
      "properties": {
        "warmup_from_bar_index": {"type": "integer", "minimum": 0},
        "from_bar_index": {"type": "integer", "minimum": 0},
        "to_bar_index": {"type": "integer", "minimum": 0}
      }
    }
  }
}
