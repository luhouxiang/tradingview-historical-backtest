{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/run-manifest.schema.json",
  "title": "BacktestRunManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "run_signature",
    "trace_id",
    "dataset",
    "range",
    "strategy",
    "execution",
    "capital",
    "engine",
    "random_seed",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "run_signature": {"$ref": "#/$defs/sha256"},
    "trace_id": {"type": "string", "minLength": 1},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "data_revision"],
      "properties": {
        "dataset_id": {"type": "string", "minLength": 1},
        "data_revision": {"$ref": "#/$defs/sha256"}
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warmup_from_bar_index", "from_bar_index", "to_bar_index"],
      "properties": {
        "warmup_from_bar_index": {"type": "integer", "minimum": 0},
        "from_bar_index": {"type": "integer", "minimum": 0},
        "to_bar_index": {"type": "integer", "minimum": 0}
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy_id", "version", "source_hash", "parameters"],
      "properties": {
        "strategy_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "source_hash": {"$ref": "#/$defs/sha256"},
        "parameters": {"type": "object", "additionalProperties": true},
        "indicator_dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["algorithm_id", "version", "source_hash"],
            "properties": {
              "algorithm_id": {"type": "string"},
              "version": {"type": "string"},
              "source_hash": {"$ref": "#/$defs/sha256"}
            },
            "additionalProperties": false
          }
        }
      }
    },
    "ranking_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "universe_id",
        "membership_revision",
        "membership_mode",
        "price_adjustment_mode",
        "price_adjustment_revision",
        "episode_id",
        "episode_start_timestamp_utc",
        "episode_available_at_utc",
        "memberships"
      ],
      "properties": {
        "universe_id": {"type": "string", "minLength": 1},
        "membership_revision": {"$ref": "#/$defs/sha256"},
        "membership_mode": {"const": "point_in_time"},
        "price_adjustment_mode": {
          "enum": ["forward_adjusted", "back_adjusted", "total_return"]
        },
        "price_adjustment_revision": {"$ref": "#/$defs/sha256"},
        "episode_id": {"type": "string", "minLength": 1},
        "episode_start_timestamp_utc": {"type": "integer", "minimum": 0},
        "episode_available_at_utc": {"type": "integer", "minimum": 0},
        "memberships": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dataset_id",
              "data_revision",
              "sector_id",
              "effective_from_utc",
              "effective_to_utc",
              "available_at_utc"
            ],
            "properties": {
              "dataset_id": {"type": "string", "minLength": 1},
              "data_revision": {"$ref": "#/$defs/sha256"},
              "sector_id": {"type": "string", "minLength": 1},
              "effective_from_utc": {"type": "integer", "minimum": 0},
              "effective_to_utc": {"type": ["integer", "null"], "minimum": 0},
              "available_at_utc": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "risk_overlay": {"$ref": "#/$defs/risk_overlay"},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signal_timing",
        "fill_timing",
        "commission",
        "slippage",
        "contract_multiplier",
        "margin_ratio"
      ],
      "properties": {
        "signal_timing": {"enum": ["bar_close"]},
        "fill_timing": {"enum": ["next_bar_open", "bar_close"]},
        "commission": {"type": "object", "additionalProperties": true},
        "slippage": {"type": "object", "additionalProperties": true},
        "stress_scenario_id": {"type": "string", "minLength": 1},
        "cost_multiplier": {"type": "number", "minimum": 0},
        "additional_slippage_ticks": {"type": "number", "minimum": 0},
        "additional_delay_bars": {"type": "integer", "minimum": 0},
        "max_volume_participation_rate": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "fill_mode": {"enum": ["unlimited", "volume_cap_ioc"]},
        "contract_multiplier": {"type": "number", "exclusiveMinimum": 0},
        "margin_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "intrabar_conflict_rule": {
          "enum": ["stop_first", "target_first", "worst_case"]
        }
      }
    },
    "capital": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_cash_i64", "currency", "money_scale"],
      "properties": {
        "initial_cash_i64": {"type": "integer", "minimum": 0},
        "currency": {"type": "string", "minLength": 3, "maxLength": 3},
        "money_scale": {"type": "integer", "minimum": 1}
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine_version", "python_version", "contract_version"],
      "properties": {
        "engine_version": {"type": "string"},
        "python_version": {"const": "3.14"},
        "contract_version": {"type": "string"}
      }
    },
    "random_seed": {"type": "integer"},
    "shared_dependency_ref": {"type": "string", "pattern": "^cache/comparison_dependencies/[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "risk_overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "parameters", "context"],
      "properties": {
        "algorithm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "algorithm_id", "algorithm_version", "source_hash"],
          "properties": {
            "kind": {"const": "risk_filter"},
            "algorithm_id": {"const": "unified_risk_execution_overlay"},
            "algorithm_version": {"type": "string", "minLength": 1},
            "source_hash": {"$ref": "#/$defs/sha256"}
          }
        },
        "parameters": {"type": "object", "additionalProperties": true},
        "context": {"$ref": "#/$defs/risk_context"}
      }
    },
    "risk_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market_state_revision", "sector_id", "legal_future_branches",
        "handled_future_branches", "observations"
      ],
      "properties": {
        "market_state_revision": {"$ref": "#/$defs/sha256"},
        "sector_id": {"type": "string", "minLength": 1},
        "legal_future_branches": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "handled_future_branches": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "observations": {
          "type": "array",
          "items": {"$ref": "#/$defs/risk_market_observation"}
        }
      }
    },
    "risk_market_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effective_from_bar_index", "available_at_bar_index", "data_revision",
        "trading_status", "stale_bars", "data_gap_bars", "event_risk_active"
      ],
      "properties": {
        "effective_from_bar_index": {"type": "integer", "minimum": 0},
        "available_at_bar_index": {"type": "integer", "minimum": 0},
        "data_revision": {"$ref": "#/$defs/sha256"},
        "trading_status": {"enum": ["normal", "suspended", "limit_up", "limit_down"]},
        "stale_bars": {"type": "integer", "minimum": 0},
        "data_gap_bars": {"type": "integer", "minimum": 0},
        "event_risk_active": {"type": "boolean"}
      }
    }
  }
}

