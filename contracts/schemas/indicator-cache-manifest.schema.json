{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/indicator-cache-manifest.schema.json",
  "title": "IndicatorCacheManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "cache_key", "dataset_id", "data_revision", "algorithm",
    "parameters", "calculation_mode", "engine_version", "coverage", "outputs",
    "values_sha256", "created_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "cache_key": {"$ref": "#/$defs/sha256"},
    "dataset_id": {"type": "string", "minLength": 1},
    "data_revision": {"$ref": "#/$defs/sha256"},
    "algorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "algorithm_id", "algorithm_version", "source_hash"],
      "properties": {
        "kind": {"const": "indicator"},
        "algorithm_id": {"type": "string", "minLength": 1},
        "algorithm_version": {"type": "string", "minLength": 1},
        "source_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "parameters": {"type": "object"},
    "calculation_mode": {"enum": ["full_history", "causal_events"]},
    "engine_version": {"type": "string", "minLength": 1},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bar_count", "first_bar_index", "last_bar_index"],
      "properties": {
        "bar_count": {"type": "integer", "minimum": 0},
        "first_bar_index": {"type": "integer", "minimum": 0},
        "last_bar_index": {"type": "integer", "minimum": 0}
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "values_sha256": {"$ref": "#/$defs/sha256"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
