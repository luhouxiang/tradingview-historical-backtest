{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/study-manifest.schema.json",
  "title": "OptimizationStudyManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "study_id", "trace_id", "dataset", "strategy",
    "base_parameters", "search_space", "objectives", "constraints", "search",
    "ranges", "execution", "capital", "evaluation_count", "selected_evaluation_index",
    "engine", "created_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "study_id": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string", "minLength": 1},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "data_revision"],
      "properties": {
        "dataset_id": {"type": "string", "minLength": 1},
        "data_revision": {"$ref": "#/$defs/sha256"}
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy_id", "version", "source_hash"],
      "properties": {
        "strategy_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "source_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "base_parameters": {"type": "object", "additionalProperties": true},
    "search_space": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/search_parameter"}},
    "objectives": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/objective"}},
    "constraints": {"type": "array", "items": {"$ref": "#/$defs/constraint"}},
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "budget", "random_seed"],
      "properties": {
        "method": {"enum": ["grid", "random"]},
        "budget": {"type": "integer", "minimum": 1, "maximum": 100},
        "random_seed": {"type": "integer"}
      }
    },
    "ranges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "validation"],
      "properties": {
        "train": {"$ref": "#/$defs/range"},
        "validation": {"$ref": "#/$defs/range"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal_timing", "fill_timing", "commission", "slippage", "contract_multiplier", "margin_ratio", "intrabar_conflict_rule"],
      "properties": {
        "signal_timing": {"const": "bar_close"},
        "fill_timing": {"enum": ["next_bar_open", "bar_close"]},
        "commission": {"type": "object", "additionalProperties": true},
        "slippage": {"type": "object", "additionalProperties": true},
        "contract_multiplier": {"type": "number", "exclusiveMinimum": 0},
        "margin_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "intrabar_conflict_rule": {"enum": ["stop_first", "target_first", "worst_case"]}
      }
    },
    "capital": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_cash_i64", "currency", "money_scale"],
      "properties": {
        "initial_cash_i64": {"type": "integer", "minimum": 0},
        "currency": {"type": "string", "minLength": 3, "maxLength": 3},
        "money_scale": {"type": "integer", "minimum": 1}
      }
    },
    "risk_overlay": {"$ref": "#/$defs/risk_overlay"},
    "evaluation_count": {"type": "integer", "minimum": 1},
    "selected_evaluation_index": {"type": "integer", "minimum": 0},
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine_version", "python_version", "contract_version"],
      "properties": {
        "engine_version": {"type": "string"},
        "python_version": {"const": "3.14"},
        "contract_version": {"type": "string"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "risk_overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "parameters", "context"],
      "properties": {
        "algorithm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "algorithm_id", "algorithm_version", "source_hash"],
          "properties": {
            "kind": {"const": "risk_filter"},
            "algorithm_id": {"const": "unified_risk_execution_overlay"},
            "algorithm_version": {"type": "string", "minLength": 1},
            "source_hash": {"$ref": "#/$defs/sha256"}
          }
        },
        "parameters": {"type": "object", "additionalProperties": true},
        "context": {"$ref": "#/$defs/risk_context"}
      }
    },
    "risk_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["market_state_revision", "sector_id", "legal_future_branches", "handled_future_branches", "observations"],
      "properties": {
        "market_state_revision": {"$ref": "#/$defs/sha256"},
        "sector_id": {"type": "string", "minLength": 1},
        "legal_future_branches": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "handled_future_branches": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "observations": {"type": "array", "items": {"$ref": "#/$defs/risk_market_observation"}}
      }
    },
    "risk_market_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effective_from_bar_index", "available_at_bar_index", "data_revision", "trading_status", "stale_bars", "data_gap_bars", "event_risk_active"],
      "properties": {
        "effective_from_bar_index": {"type": "integer", "minimum": 0},
        "available_at_bar_index": {"type": "integer", "minimum": 0},
        "data_revision": {"$ref": "#/$defs/sha256"},
        "trading_status": {"enum": ["normal", "suspended", "limit_up", "limit_down"]},
        "stale_bars": {"type": "integer", "minimum": 0},
        "data_gap_bars": {"type": "integer", "minimum": 0},
        "event_risk_active": {"type": "boolean"}
      }
    },
    "metric": {"enum": ["total_return", "sharpe", "max_drawdown", "win_rate", "trade_count", "profit_factor", "expectancy_i64"]},
    "search_parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {"enum": ["integer", "number", "boolean", "string"]},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "step": {"type": "number", "exclusiveMinimum": 0},
        "candidates": {"type": "array", "minItems": 1}
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "direction"],
      "properties": {
        "metric": {"$ref": "#/$defs/metric"},
        "direction": {"enum": ["maximize", "minimize"]}
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "operator", "value"],
      "properties": {
        "metric": {"$ref": "#/$defs/metric"},
        "operator": {"enum": [">=", "<="]},
        "value": {"type": "number"}
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warmup_from_bar_index", "from_bar_index", "to_bar_index"],
      "properties": {
        "warmup_from_bar_index": {"type": "integer", "minimum": 0},
        "from_bar_index": {"type": "integer", "minimum": 0},
        "to_bar_index": {"type": "integer", "minimum": 0}
      }
    }
  }
}
